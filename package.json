{
  "name": "handback",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "init": "bun scripts/init.ts",
    "make:og": "node scripts/make-og.mjs",
    "dev": "portless run bun --watch server.ts",
    "build": "bun run clean && bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:extension": "npm --prefix extension run build",
    "zip:extension": "pwsh -NoProfile -Command \"Compress-Archive -Path extension/dist/* -DestinationPath extension/handback-recorder.zip -Force\"",
    "pack:store": "bun run build:extension && node extension/scripts/pack-store.mjs",
    "publish:extension": "bun run build:extension && bun run zip:extension && bun cli/publish-recorder.ts",
    "start": "cross-env NODE_ENV=production bun server.ts",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "typecheck": "tsgo --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "prettier": "prettier ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-query-devtools": "^5.100.5",
    "@trpc/client": "^11",
    "@trpc/server": "^11",
    "@trpc/tanstack-react-query": "^11",
    "better-auth": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "cross-env": "^7.0.3",
    "express": "^5",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.53.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.3",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "portless": "^0.15.5",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
