DATABASE_URL=postgres://postgres:postgres@localhost:5432/handback
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3995
AWS_REGION=us-west-2
S3_BUCKET=handback-files
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional. Without it /api/ingest/transcribe answers 503 and the recorder falls
# back to its on-device Whisper pass — slow, but nothing breaks.
GROQ_API_KEY=

# Stripe billing. All optional — unset means billing is off (/upgrade shows the
# "write us" fallback, checkout/portal refuse, the webhook 503s). Create the
# products + prices with `bun cli/stripe-setup.ts`, which prints the price ids.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BIZ=
