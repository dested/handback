// Prisma schema — https://pris.ly/d/prisma-schema
//
// Models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map`.
//
// App models: Team → Membership/Invite, Walkthrough → Take/WalkthroughFile,
// ApiToken hanging off User. There is no workspace: content lives in a *space*,
// and a space is the ownership pair `teamId | userId` on Project/Walkthrough —
// exactly one of the two is set. `userId` set means someone's personal space,
// which is the absence of a team and needs no provisioning.
// File payloads (video, frames, grids, report.md, recording.json) live in S3
// under orgs/<teamId ?? userId>/gripes/<walkthroughId>/<path> — the `orgs/` and
// `gripes/` segments are frozen at the old product nouns, because every object
// already uploaded lives there. The DB holds listing and routing metadata only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  // Platform flags, set from /admin (billing doesn't exist yet): site admin +
  // hand-granted feature entitlements ("team").
  isAdmin       Boolean  @default(false) @map("is_admin")
  features      String[] @default([])
  // Mail mutes + bookkeeping. One-click unsubscribe (the email footers) flips
  // them off; the /team personal card flips them back. `digestSentAt` is when
  // the last weekly digest went out (null = never), the guard that keeps the
  // hourly sweep from double-sending inside one Monday window.
  notifyUploads Boolean   @default(true) @map("notify_uploads")
  notifyDigest  Boolean   @default(true) @map("notify_digest")
  // "Your agent answered / asked" mail — the uploader-only doorbell on the
  // return path, muted by its own unsubscribe kind ('results').
  notifyResults Boolean   @default(true) @map("notify_results")
  digestSentAt  DateTime? @map("digest_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  sessions     Session[]
  accounts     Account[]
  memberships  Membership[]
  apiTokens    ApiToken[]
  uploads      Walkthrough[]  @relation("uploader")
  // The personal space: rows owned by this account rather than a team.
  walkthroughs Walkthrough[]  @relation("personal")
  projects     Project[]      @relation("personalProjects")
  ownedTeams   Team[]               @relation("teamOwner")
  monthlyUsage MonthlyUsage[]
  comments     WalkthroughComment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

// A team is the only explicit space. The owner is authoritative here, not in a
// membership role — `ownerId` is what transferOwnership moves — and the owner
// also holds a Membership row so the roster is complete.
model Team {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  owner     User     @relation("teamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  seatLimit Int      @default(5) @map("seat_limit")
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  invites      Invite[]
  projects     Project[]
  walkthroughs Walkthrough[]

  @@map("team")
}

model Membership {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // admin | member only — "owner" is never stored, it's Team.ownerId.
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@map("membership")
}

// The invite id IS the link token (/join/<id>). It's emailed when an address
// was given and Resend is configured; the creator gets the link back either
// way, so a failed send degrades to copy-paste.
model Invite {
  id           String    @id @default(uuid())
  teamId       String    @map("team_id")
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email        String?
  role         String    @default("member")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  acceptedById String?   @map("accepted_by_id")
  acceptedAt   DateTime? @map("accepted_at")

  @@map("invite")
}

model Project {
  id          String   @id @default(uuid())
  // Ownership pair: exactly one of teamId / userId is set. Prisma can't express
  // a partial unique over a nullable pair, so slug uniqueness per space is
  // enforced in code (findFirst + suffix loop), not by the database.
  teamId      String?  @map("team_id")
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id")
  user        User?    @relation("personalProjects", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // URL origins (https://app.example.com) used to auto-route uploaded walkthroughs
  // by their recorded origin.
  originHints String[] @map("origin_hints")
  // Standing context for agents — prepended to every brief pulled from this
  // project ("repo lives at ~/code/x, run typecheck before posting a result").
  instructions String?
  createdAt   DateTime @default(now()) @map("created_at")

  walkthroughs Walkthrough[]

  @@map("project")
}

model Walkthrough {
  id           String    @id @default(uuid())
  // Ownership pair: exactly one of teamId / userId is set (code invariant).
  // S3 keys live under orgs/<teamId ?? userId>/gripes/<id>/ — the `orgs/` and
  // `gripes/` segments are frozen at the old product nouns.
  teamId       String?   @map("team_id")
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?   @map("user_id")
  user         User?     @relation("personal", fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // The extension's folder name (2026-07-29-1412-<slug>); kept unique per space
  // in code so a re-push of the same folder replaces rather than duplicates.
  slug         String
  title        String
  origin       String? // site origin the walkthrough was recorded on
  status       String    @default("open") // open | in_review | resolved
  // Who the walkthrough is FOR. 'agent' = distilled raw material (frames +
  // report, video quality irrelevant); 'human' = the edited video IS the
  // deliverable (final.mp4 primary, no distill, hidden from agent lists).
  kind         String    @default("agent") // agent | human
  // Token-guarded public watch link (/w/<token>). The token is the whole
  // credential, like an unaddressed invite; null = not shared.
  shareToken   String?   @unique @map("share_token")
  sharedAt     DateTime? @map("shared_at")
  recordedAt   DateTime  @map("recorded_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  uploadedById String?   @map("uploaded_by_id")
  uploadedBy   User?     @relation("uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  durationMs   Int       @default(0) @map("duration_ms")
  frameCount   Int       @default(0) @map("frame_count")
  // Console errors/warns + failed requests the page reported *while recording* —
  // never clicks or navigation. Zero means the page never complained.
  errorCount   Int       @default(0) @map("error_count")
  // Errors that fired on a tab other than the recorded one, counted and thrown
  // away. Distinguishes "nothing broke" from "we weren't looking there".
  droppedCount Int       @default(0) @map("dropped_count")
  bytes        BigInt    @default(0)
  // Set when the uploader confirms every declared file landed in S3; the
  // walkthrough list only shows finalized walkthroughs.
  finalizedAt  DateTime? @map("finalized_at")
  resolvedAt   DateTime? @map("resolved_at")
  // Retention bookkeeping (server/retention.ts). `expiresAt` is when the whole
  // walkthrough auto-deletes — stamped when it's marked resolved, cleared when
  // it moves off resolved or someone hits Keep; null = no expiry scheduled.
  // `renderedAt` is when a human handback's final.mp4 landed, the clock the raw
  // takes expire off. `rawsPurgedAt` records that the raw-take purge already ran
  // so the sweep does it once.
  expiresAt    DateTime? @map("expires_at")
  renderedAt   DateTime? @map("rendered_at")
  rawsPurgedAt DateTime? @map("raws_purged_at")
  // Full-text corpus, filled at finalize (server/search.ts): report.md for
  // agent kind, the transcript for human kind. Searched with a query-time
  // to_tsvector — no GIN index yet, deliberate at current row counts.
  searchText   String?   @map("search_text")
  // The split (server/structure.ts): a child task is a metadata-only row —
  // no files, no takes, ~0 bytes — whose brief lives in `briefMd` and whose
  // evidence (frames, video, report) lives on the parent. SetNull so children
  // survive the parent's deletion as plain standalone tasks.
  parentId     String?   @map("parent_id")
  parent       Walkthrough?  @relation("split", fields: [parentId], references: [id], onDelete: SetNull)
  children     Walkthrough[] @relation("split")
  // The child's whole content: markdown authored by the structuring pass
  // (severity, repro, acceptance criteria, source time ranges). When set, the
  // agent brief serves it as the report.
  briefMd      String?   @map("brief_md")
  // What the recording is FOR — 'bug' | 'feature' | 'idea'; null = untagged
  // (old recorders, or the person never said). Drives the brief's framing and
  // the refine prompts; never guessed server-side.
  intent       String?
  // The Refine pass (server/refine.ts, pro-gated). Original report.md in S3 is
  // never touched: the rewrite lives here and the brief prefers it.
  // summaryMd = the terse-but-complete ledger of everything raised;
  // refinedBriefMd = the intent-aware brief agents read; healthJson =
  // [{severity:'info'|'warn', text, atMs|null}] capture-QC notes for the
  // uploader; curationJson = {frames:[{path, caption, atMs|null}],
  // excluded:[{startMs, endMs, reason}]} — excluded spans are markers only,
  // the video is never re-encoded.
  summaryMd      String?   @map("summary_md")
  refinedBriefMd String?   @map("refined_brief_md")
  healthJson     Json?     @map("health_json")
  curationJson   Json?     @map("curation_json")
  refineStatus   String?   @map("refine_status") // 'running' | 'done' | 'failed'
  refinedAt      DateTime? @map("refined_at")
  // The human-first read (2026-08-23 viewer rethink): digestMd = 2–4 plain
  // sentences a person reads first; pointsJson = KeyPoint[] ({id 'kpN', title,
  // detail, severity 'high'|'medium'|'low', atMs|null}) — the structured spine
  // the brief numbers as obligations and post_result answers point by point;
  // suggestedTitle = refine's title when a human-chosen one was kept (never
  // overwritten); refineStage = 'reading'|'frames'|'writing' while running,
  // null otherwise — the viewer's live progress copy.
  digestMd       String?   @map("digest_md")
  pointsJson     Json?     @map("points_json")
  suggestedTitle String?   @map("suggested_title")
  refineStage    String?   @map("refine_stage")
  refineRuns     Int       @default(0) @map("refine_runs")

  takes     Take[]
  files     WalkthroughFile[]
  notes     WalkthroughNote[]
  access    WalkthroughAccess[]
  comments  WalkthroughComment[]
  chats     WalkthroughChat[]
  revisions WalkthroughRevision[]

  @@map("walkthrough")
}

// A reviewer's margin note, optionally pinned to a moment of the recording
// (`atMs` on the walkthrough-wide output clock). Comments ride into the agent
// brief, so a comment is also an instruction. `authorName` denormalized like
// the review thread; `userId` survives only to enforce "delete your own".
model WalkthroughComment {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName    String      @map("author_name")
  atMs          Int?        @map("at_ms")
  text          String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([walkthroughId, createdAt])
  @@map("walkthrough_comment")
}

// The review exchange on a walkthrough, one chronological thread: an agent's
// posted result (`role: 'agent'` — summary + optional PR link / files touched /
// markdown body) and the reviewer's send-back notes (`role: 'reviewer'` —
// summary IS the note). The agent brief renders the whole thread, so an agent
// re-pulling a sent-back walkthrough reads the reviewer's note in place.
// `authorName` is denormalized on purpose: tokens get revoked and accounts get
// deleted, but the thread should still read.
model WalkthroughNote {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  role          String // 'agent' | 'reviewer'
  // What the entry is: 'result' (agent's answer, or a reviewer send-back),
  // 'question' (agent asking — flips status to needs_info), 'answer' (the
  // reviewer's reply — flips back to open).
  kind          String      @default("result")
  // Walkthrough-relative paths (evidence/<ts>-<name>) of proof screenshots the
  // agent attached to this entry via attach_evidence.
  evidencePaths String[]    @default([]) @map("evidence_paths")
  summary       String
  prUrl         String?     @map("pr_url")
  filesTouched  String[]    @map("files_touched")
  bodyMd        String?     @map("body_md")
  // On a kind:'result' note: PointOutcome[] ({point 'kpN', status
  // 'fixed'|'partial'|'skipped'|'not_applicable', note}) mapping the agent's
  // work back to the walkthrough's key points. Null from agents that predate it.
  outcomesJson  Json?       @map("outcomes_json")
  authorName    String      @map("author_name")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([walkthroughId, createdAt])
  @@map("walkthrough_note")
}

// The agent activity trace: what a token did to a walkthrough, so the viewer
// can say "pulled by <token> 12m ago". Written fire-and-forget from the
// token-authed surfaces only (never the web viewer's own reads); `pulled` rows
// are deduped within a window so a chatty agent doesn't flood it. Cascades with
// the walkthrough, which is also its retention story.
model WalkthroughAccess {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  tokenName     String      @map("token_name")
  action        String // 'pulled' | 'status' | 'result'
  detail        String? // the status value for 'status'; null otherwise
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([walkthroughId, createdAt])
  @@map("walkthrough_access")
}

// The walkthrough agent's conversation (walkthroughs.chat) — persisted so a
// reload keeps the thread. `userId` is a plain column (no FK): the transcript
// should read even after the account goes. `actions` is the applied tool calls
// for that assistant turn, as [{action, detail}] for the transcript's meta line.
model WalkthroughChat {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  userId        String?     @map("user_id")
  role          String // 'user' | 'assistant'
  content       String
  actions       Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([walkthroughId, createdAt])
  @@map("walkthrough_chat")
}

// The mutation log behind the walkthrough agent: every edit it applies (and any
// future non-chat mutation worth auditing) lands here, so "what did it change?"
// always has an answer. Append-only.
model WalkthroughRevision {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  authorName    String      @map("author_name") // 'assistant' or the human's name
  action        String // tool name: update_title | update_summary | update_brief | edit_transcript | remove_span | set_curated_frames
  detail        Json?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([walkthroughId, createdAt])
  @@map("walkthrough_revision")
}

model Take {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  index         Int // names rec-NN
  dir           String // "rec-01"
  interrupted   Boolean     @default(false)
  startedAt     DateTime?   @map("started_at")
  durationMs    Int         @default(0) @map("duration_ms")
  frameCount    Int         @default(0) @map("frame_count")
  transcriber   String?
  videoPath     String?     @map("video_path") // walkthrough-relative, e.g. rec-01/walkthrough.webm

  @@unique([walkthroughId, index])
  @@map("take")
}

// One row per uploaded object. `path` is walkthrough-relative (report.md,
// rec-01/frames/03-0125.jpg); the S3 key is
// orgs/<teamId ?? userId>/gripes/<walkthroughId>/<path>.
model WalkthroughFile {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  path          String
  size          Int         @default(0)
  contentType   String      @map("content_type")
  status        String      @default("pending") // pending | uploaded
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([walkthroughId, path])
  @@map("walkthrough_file")
}

// Bearer tokens for the CLI / extension / MCP (`hb_...`). Only the sha256
// hash is stored; lastFour is for display. A token IS the user: it reaches the
// owner's personal space and every team they belong to, and loses a team's
// content the moment their membership does.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastFour   String    @map("last_four")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("api_token")
}

// Per-user, per-month meter for the metered cloud passes. Checked and
// incremented by server/usage.ts before Groq/Anthropic are billed: the free tier
// gets a small monthly transcription budget, Pro a high abuse ceiling, and a
// user's first-ever walkthrough is unmetered magic (server/limits.ts holds the
// numbers). One row per (user, month) — `month` is a 'YYYY-MM' UTC bucket.
model MonthlyUsage {
  id                String @id @default(uuid())
  userId            String @map("user_id")
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             String // 'YYYY-MM' UTC
  transcribeSeconds Int    @default(0) @map("transcribe_seconds")
  polishCalls       Int    @default(0) @map("polish_calls")
  assistantTurns    Int    @default(0) @map("assistant_turns")
  walkthroughs      Int    @default(0)

  @@unique([userId, month])
  @@map("monthly_usage")
}

// Admin-editable singletons persisted as JSON, keyed by a stable string. Today
// it holds only the pricing PLANNING model ('pricing-model'), edited from
// /admin/pricing and trended against by /admin/costs (server/pricing.ts). This
// is planning data — enforcement constants live in server/limits.ts.
model AdminSetting {
  key       String   @id
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}
