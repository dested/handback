// Prisma schema — https://pris.ly/d/prisma-schema
//
// Models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map`.
//
// App models: Org → Membership/Invite/Project/ApiToken, Gripe → Take/GripeFile.
// File payloads (video, frames, grids, report.md, recording.json) live in S3
// under orgs/<orgId>/gripes/<gripeId>/<path>; the DB holds listing and routing
// metadata only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  apiTokens   ApiToken[]
  uploads     Gripe[]      @relation("uploader")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

model Org {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  invites     Invite[]
  projects    Project[]
  gripes      Gripe[]
  apiTokens   ApiToken[]

  @@map("org")
}

model Membership {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orgId, userId])
  @@map("membership")
}

// The invite id IS the link token (/join/<id>). No email sending in v1 —
// the creator copies the link.
model Invite {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String?
  role         String    @default("member")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  acceptedById String?   @map("accepted_by_id")
  acceptedAt   DateTime? @map("accepted_at")

  @@map("invite")
}

model Project {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // URL origins (https://app.example.com) used to auto-route uploaded gripes
  // by their recorded origin.
  originHints String[] @map("origin_hints")
  createdAt   DateTime @default(now()) @map("created_at")

  gripes Gripe[]

  @@unique([orgId, slug])
  @@map("project")
}

model Gripe {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // The extension's folder name (2026-07-29-1412-<slug>); unique per org so a
  // re-push of the same folder replaces rather than duplicates.
  slug         String
  title        String
  origin       String? // site origin the walkthrough was recorded on
  status       String    @default("open") // open | in_review | resolved
  recordedAt   DateTime  @map("recorded_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  uploadedById String?   @map("uploaded_by_id")
  uploadedBy   User?     @relation("uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  durationMs   Int       @default(0) @map("duration_ms")
  frameCount   Int       @default(0) @map("frame_count")
  eventCount   Int       @default(0) @map("event_count")
  bytes        BigInt    @default(0)
  // Set when the uploader confirms every declared file landed in S3; the
  // gripe list only shows finalized gripes.
  finalizedAt  DateTime? @map("finalized_at")
  resolvedAt   DateTime? @map("resolved_at")

  takes Take[]
  files GripeFile[]

  @@unique([orgId, slug])
  @@map("gripe")
}

model Take {
  id          String    @id @default(uuid())
  gripeId     String    @map("gripe_id")
  gripe       Gripe     @relation(fields: [gripeId], references: [id], onDelete: Cascade)
  index       Int // names rec-NN
  dir         String // "rec-01"
  interrupted Boolean   @default(false)
  startedAt   DateTime? @map("started_at")
  durationMs  Int       @default(0) @map("duration_ms")
  frameCount  Int       @default(0) @map("frame_count")
  transcriber String?
  videoPath   String?   @map("video_path") // gripe-relative, e.g. rec-01/walkthrough.webm

  @@unique([gripeId, index])
  @@map("take")
}

// One row per uploaded object. `path` is gripe-relative (report.md,
// rec-01/frames/03-0125.jpg); the S3 key is orgs/<orgId>/gripes/<gripeId>/<path>.
model GripeFile {
  id          String   @id @default(uuid())
  gripeId     String   @map("gripe_id")
  gripe       Gripe    @relation(fields: [gripeId], references: [id], onDelete: Cascade)
  path        String
  size        Int      @default(0)
  contentType String   @map("content_type")
  status      String   @default("pending") // pending | uploaded
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([gripeId, path])
  @@map("gripe_file")
}

// Bearer tokens for the CLI / extension / MCP (`hb_...`). Only the sha256
// hash is stored; lastFour is for display.
model ApiToken {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastFour   String    @map("last_four")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("api_token")
}
