// Prisma schema — https://pris.ly/d/prisma-schema
//
// Models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map`.
//
// App models: Org → Membership/Invite/Project/ApiToken, Walkthrough → Take/WalkthroughFile.
// File payloads (video, frames, grids, report.md, recording.json) live in S3
// under orgs/<orgId>/gripes/<walkthroughId>/<path> — the `gripes/` segment is
// frozen at the old product noun, because every object already uploaded lives
// there. The DB holds listing and routing metadata only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  // Platform flags, set from /admin (billing doesn't exist yet): site admin +
  // hand-granted feature entitlements ("team").
  isAdmin       Boolean  @default(false) @map("is_admin")
  features      String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  apiTokens   ApiToken[]
  uploads     Walkthrough[] @relation("uploader")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

model Org {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  // A personal workspace is one account's own: no members, no invites.
  personal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  invites      Invite[]
  projects     Project[]
  walkthroughs Walkthrough[]
  apiTokens    ApiToken[]

  @@map("org")
}

model Membership {
  id            String          @id @default(uuid())
  orgId         String          @map("org_id")
  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String          @map("user_id")
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String          @default("member") // owner | admin | member
  createdAt     DateTime        @default(now()) @map("created_at")
  // "org" members see the whole workspace; "projects" members (guests) see
  // only the projects granted in projectAccess and are always role "member".
  scope         String          @default("org") // org | projects
  projectAccess ProjectAccess[]

  @@unique([orgId, userId])
  @@map("membership")
}

model ProjectAccess {
  id           String     @id @default(uuid())
  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectId    String     @map("project_id")
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([membershipId, projectId])
  @@map("project_access")
}

// The invite id IS the link token (/join/<id>). It's emailed when an address
// was given and Resend is configured; the creator gets the link back either
// way, so a failed send degrades to copy-paste.
model Invite {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String?
  role         String    @default("member")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  acceptedById String?   @map("accepted_by_id")
  acceptedAt   DateTime? @map("accepted_at")
  // Set = a guest invite scoped to one project (role is forced to member).
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("invite")
}

model Project {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // URL origins (https://app.example.com) used to auto-route uploaded walkthroughs
  // by their recorded origin.
  originHints String[] @map("origin_hints")
  createdAt   DateTime @default(now()) @map("created_at")

  walkthroughs Walkthrough[]
  access       ProjectAccess[]
  invites      Invite[]

  @@unique([orgId, slug])
  @@map("project")
}

model Walkthrough {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  org          Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // The extension's folder name (2026-07-29-1412-<slug>); unique per org so a
  // re-push of the same folder replaces rather than duplicates.
  slug         String
  title        String
  origin       String? // site origin the walkthrough was recorded on
  status       String    @default("open") // open | in_review | resolved
  recordedAt   DateTime  @map("recorded_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  uploadedById String?   @map("uploaded_by_id")
  uploadedBy   User?     @relation("uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  durationMs   Int       @default(0) @map("duration_ms")
  frameCount   Int       @default(0) @map("frame_count")
  // Console errors/warns + failed requests the page reported *while recording* —
  // never clicks or navigation. Zero means the page never complained.
  errorCount   Int       @default(0) @map("error_count")
  // Errors that fired on a tab other than the recorded one, counted and thrown
  // away. Distinguishes "nothing broke" from "we weren't looking there".
  droppedCount Int       @default(0) @map("dropped_count")
  bytes        BigInt    @default(0)
  // Set when the uploader confirms every declared file landed in S3; the
  // walkthrough list only shows finalized walkthroughs.
  finalizedAt  DateTime? @map("finalized_at")
  resolvedAt   DateTime? @map("resolved_at")

  takes Take[]
  files WalkthroughFile[]

  @@unique([orgId, slug])
  @@map("walkthrough")
}

model Take {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  index         Int // names rec-NN
  dir           String // "rec-01"
  interrupted   Boolean     @default(false)
  startedAt     DateTime?   @map("started_at")
  durationMs    Int         @default(0) @map("duration_ms")
  frameCount    Int         @default(0) @map("frame_count")
  transcriber   String?
  videoPath     String?     @map("video_path") // walkthrough-relative, e.g. rec-01/walkthrough.webm

  @@unique([walkthroughId, index])
  @@map("take")
}

// One row per uploaded object. `path` is walkthrough-relative (report.md,
// rec-01/frames/03-0125.jpg); the S3 key is orgs/<orgId>/gripes/<walkthroughId>/<path>.
model WalkthroughFile {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  path          String
  size          Int         @default(0)
  contentType   String      @map("content_type")
  status        String      @default("pending") // pending | uploaded
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([walkthroughId, path])
  @@map("walkthrough_file")
}

// Bearer tokens for the CLI / extension / MCP (`hb_...`). Only the sha256
// hash is stored; lastFour is for display.
model ApiToken {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastFour   String    @map("last_four")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("api_token")
}
