// Prisma schema — https://pris.ly/d/prisma-schema
//
// Models match better-auth's required shape (user / session / account /
// verification). Field names are camelCase (better-auth queries them by name);
// columns are snake_case via `@map`.
//
// App models: Team → Membership/Invite, Walkthrough → Take/WalkthroughFile,
// ApiToken hanging off User. There is no workspace: content lives in a *space*,
// and a space is the ownership pair `teamId | userId` on Project/Walkthrough —
// exactly one of the two is set. `userId` set means someone's personal space,
// which is the absence of a team and needs no provisioning.
// File payloads (video, frames, grids, report.md, recording.json) live in S3
// under orgs/<teamId ?? userId>/gripes/<walkthroughId>/<path> — the `orgs/` and
// `gripes/` segments are frozen at the old product nouns, because every object
// already uploaded lives there. The DB holds listing and routing metadata only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  // Platform flags, set from /admin (billing doesn't exist yet): site admin +
  // hand-granted feature entitlements ("team").
  isAdmin       Boolean  @default(false) @map("is_admin")
  features      String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  sessions     Session[]
  accounts     Account[]
  memberships  Membership[]
  apiTokens    ApiToken[]
  uploads      Walkthrough[] @relation("uploader")
  // The personal space: rows owned by this account rather than a team.
  walkthroughs Walkthrough[] @relation("personal")
  projects     Project[]     @relation("personalProjects")
  ownedTeams   Team[]        @relation("teamOwner")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @default(now()) @map("updated_at")

  @@map("verification")
}

// A team is the only explicit space. The owner is authoritative here, not in a
// membership role — `ownerId` is what transferOwnership moves — and the owner
// also holds a Membership row so the roster is complete.
model Team {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  owner     User     @relation("teamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  seatLimit Int      @default(5) @map("seat_limit")
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  invites      Invite[]
  projects     Project[]
  walkthroughs Walkthrough[]

  @@map("team")
}

model Membership {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // admin | member only — "owner" is never stored, it's Team.ownerId.
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([teamId, userId])
  @@map("membership")
}

// The invite id IS the link token (/join/<id>). It's emailed when an address
// was given and Resend is configured; the creator gets the link back either
// way, so a failed send degrades to copy-paste.
model Invite {
  id           String    @id @default(uuid())
  teamId       String    @map("team_id")
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email        String?
  role         String    @default("member")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  acceptedById String?   @map("accepted_by_id")
  acceptedAt   DateTime? @map("accepted_at")

  @@map("invite")
}

model Project {
  id          String   @id @default(uuid())
  // Ownership pair: exactly one of teamId / userId is set. Prisma can't express
  // a partial unique over a nullable pair, so slug uniqueness per space is
  // enforced in code (findFirst + suffix loop), not by the database.
  teamId      String?  @map("team_id")
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id")
  user        User?    @relation("personalProjects", fields: [userId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  // URL origins (https://app.example.com) used to auto-route uploaded walkthroughs
  // by their recorded origin.
  originHints String[] @map("origin_hints")
  createdAt   DateTime @default(now()) @map("created_at")

  walkthroughs Walkthrough[]

  @@map("project")
}

model Walkthrough {
  id           String    @id @default(uuid())
  // Ownership pair: exactly one of teamId / userId is set (code invariant).
  // S3 keys live under orgs/<teamId ?? userId>/gripes/<id>/ — the `orgs/` and
  // `gripes/` segments are frozen at the old product nouns.
  teamId       String?   @map("team_id")
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String?   @map("user_id")
  user         User?     @relation("personal", fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?   @map("project_id")
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // The extension's folder name (2026-07-29-1412-<slug>); kept unique per space
  // in code so a re-push of the same folder replaces rather than duplicates.
  slug         String
  title        String
  origin       String? // site origin the walkthrough was recorded on
  status       String    @default("open") // open | in_review | resolved
  recordedAt   DateTime  @map("recorded_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  uploadedById String?   @map("uploaded_by_id")
  uploadedBy   User?     @relation("uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  durationMs   Int       @default(0) @map("duration_ms")
  frameCount   Int       @default(0) @map("frame_count")
  // Console errors/warns + failed requests the page reported *while recording* —
  // never clicks or navigation. Zero means the page never complained.
  errorCount   Int       @default(0) @map("error_count")
  // Errors that fired on a tab other than the recorded one, counted and thrown
  // away. Distinguishes "nothing broke" from "we weren't looking there".
  droppedCount Int       @default(0) @map("dropped_count")
  bytes        BigInt    @default(0)
  // Set when the uploader confirms every declared file landed in S3; the
  // walkthrough list only shows finalized walkthroughs.
  finalizedAt  DateTime? @map("finalized_at")
  resolvedAt   DateTime? @map("resolved_at")

  takes Take[]
  files WalkthroughFile[]

  @@map("walkthrough")
}

model Take {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  index         Int // names rec-NN
  dir           String // "rec-01"
  interrupted   Boolean     @default(false)
  startedAt     DateTime?   @map("started_at")
  durationMs    Int         @default(0) @map("duration_ms")
  frameCount    Int         @default(0) @map("frame_count")
  transcriber   String?
  videoPath     String?     @map("video_path") // walkthrough-relative, e.g. rec-01/walkthrough.webm

  @@unique([walkthroughId, index])
  @@map("take")
}

// One row per uploaded object. `path` is walkthrough-relative (report.md,
// rec-01/frames/03-0125.jpg); the S3 key is
// orgs/<teamId ?? userId>/gripes/<walkthroughId>/<path>.
model WalkthroughFile {
  id            String      @id @default(uuid())
  walkthroughId String      @map("walkthrough_id")
  walkthrough   Walkthrough @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  path          String
  size          Int         @default(0)
  contentType   String      @map("content_type")
  status        String      @default("pending") // pending | uploaded
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([walkthroughId, path])
  @@map("walkthrough_file")
}

// Bearer tokens for the CLI / extension / MCP (`hb_...`). Only the sha256
// hash is stored; lastFour is for display. A token IS the user: it reaches the
// owner's personal space and every team they belong to, and loses a team's
// content the moment their membership does.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  lastFour   String    @map("last_four")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("api_token")
}
